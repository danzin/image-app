    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Loki raw-log explorer filtered by bounded stream labels and Alloy structured metadata. Incident answered: what exact structured record should an operator inspect next? The default level is error; correlation and error ID filters remain optional.\n\n```logql\n{compose_project=\"ascendance-social\", service_name=~\"$service\", level=~\"$level\"} | correlation_id=~\"$correlationId\" | error_id=~\"$errorId\"\n```",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLines": false
      },
      "targets": [
        {
          "direction": "backward",
          "expr": "{compose_project=\"ascendance-social\", service_name=~\"$service\", level=~\"$level\"} | correlation_id=~\"$correlationId\" | error_id=~\"$errorId\"",
          "maxLines": 200,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Raw operational logs",
      "type": "logs"
    }
